# ═══════════════════════════════════════════════════════
#  VAJANS — Environment Configuration Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────
APP_NAME=VAJANS
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALLOWED_HOSTS=["http://localhost:3000","http://localhost:5173"]

# ── Database ───────────────────────────────────────────
# OPTION A: Supabase (Recommended for production)
# Get your connection string from: https://app.supabase.com → Settings → Database
# Then replace YOUR_PASSWORD and YOUR_PROJECT_ID:
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres?ssl=require

# OPTION B: Local PostgreSQL (Development)
# Uncomment below and configure:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vajans
DB_USER=vajans
DB_PASSWORD=vajans_dev_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
DB_SSL_MODE=disable

# ── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ── Storage ────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage

# For S3 (set STORAGE_BACKEND=s3 and fill below):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=vajans-documents
# S3_PREFIX=vajans/

# ── OpenRouter / LLM ───────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# ── Embeddings ─────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ── FAISS ──────────────────────────────────────────────
FAISS_INDEX_PATH=./data/faiss

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text
