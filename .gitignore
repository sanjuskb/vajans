# ════════════════════════════════════════════════════════
#  VAJANS — Production-Grade .gitignore
#  Keep this file updated whenever new tooling is added.
# ════════════════════════════════════════════════════════

# ── Secrets & Credentials ────────────────────────────────
.env
.env.*
*.env
*.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
credentials/
*.secret

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
lib/
lib64/
.installed.cfg
.venv/
venv/
ENV/
env/
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
htmlcov/

# ── Node / Frontend ──────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
.yarn/
dist/
build/
.next/
out/
.nuxt/
.cache/
*.tsbuildinfo
.parcel-cache/

# ── Data & Storage ───────────────────────────────────────
data/
uploads/
storage/
*.faiss
*.index
*.pkl
*.npy
*.h5

# ── Logs ─────────────────────────────────────────────────
*.log
*.log.*
logs/
/tmp/

# ── OS / Editor / IDE ────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── Backups ──────────────────────────────────────────────
*.bak
*.bak.*
*.backup
*.backup.*
*.orig
*.old
*.tmp

# ── Docker ───────────────────────────────────────────────
.docker/
docker-data/

# ── Celery ───────────────────────────────────────────────
celerybeat-schedule
celerybeat.pid

# ── Testing ──────────────────────────────────────────────
.pytest_cache/
*.pytest_cache/

# ── Alembic ──────────────────────────────────────────────
# (keep alembic/versions/ tracked — migrations are source code)

# ── Misc ─────────────────────────────────────────────────
*.pid
*.sock
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── AI IDE settings (local, machine-specific) ────────────
.claude/
.cursor/
.windsurf/

# ── Frontend build output ────────────────────────────────
frontend/dist/
